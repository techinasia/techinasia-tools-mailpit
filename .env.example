# Mailpit Configuration
# Copy this file to .env and customize as needed

# Version to build (optional)
VERSION=dev

# Web UI port
WEB_PORT=8025

# SMTP port
SMTP_PORT=1025

# POP3 port (optional)
POP3_PORT=1110

# Maximum messages to store
MP_MAX_MESSAGES=500

# Authentication (optional)
# MP_UI_AUTH_FILE=/config/htpasswd

# TLS Configuration (optional)
# MP_UI_TLS_CERT=/config/cert.pem
# MP_UI_TLS_KEY=/config/key.pem
